+#if defined(SM64COOPDX_CN_TEXT)
+// Called once the vanilla rom has been imported and DJUI is up.
+//
+// Nothing about the pack is compiled in: the glyphs, the dialog text, the
+// course/act names and the localised textures are all read out of the player's
+// own 神游 dump at startup (cn_rom_assets.c). Owning the cartridge is therefore
+// no longer a condition we merely *check* -- without it there are no pixels and
+// no strings, so the pack cannot be shown at all.
+//
+//   * the exact 神游 (iQue) rom dump is present -> on, unless the player
+//     unchecked the box (the checkbox is the only thing that ever changes it)
+//   * it is not present -> off for this session and the settings checkbox is
+//     greyed out (djui_panel_misc.c)
+//
+// Mods -- romhacks included -- are no longer consulted here: the pack defers to
+// whatever a mod installed, entry by entry. See cn_text_gate.h for the three
+// mechanisms that make that true.
+//
+// configChineseText is the checkbox position, not the live state -- a config
+// written by an older build can carry "true" on a machine that never supplied
+// the rom, and the pack must not light up because of it. Only the live state
+// changes here; the stored value is left alone (see below).
+static void chinese_text_pack_init(void) {
+    bool const detected = rom_checker_ique_rom_present();
+
+    // The pack is no longer compiled into the binary: every glyph, dialog
+    // string and localised texture is read out of the player's own 神游 dump at
+    // startup (cn_rom_assets.c). Owning the cartridge is therefore no longer a
+    // precondition we merely *check* -- without it there is no data to show.
+    bool const loaded = detected && cn_rom_assets_load(rom_checker_ique_rom_path());
+
+    // No rom / unreadable rom -> off. Otherwise the checkbox decides, and its
+    // default is on. The rule itself lives in cn_text_gate.h so it can be
+    // tested on its own.
+    bool const target = cn_text_pack_target(loaded, configChineseText);
+
+    // configChineseText is deliberately left as the player wrote it: it is the
+    // checkbox position, not the live state. A missing dump only means "not
+    // this session", and storing false here would make one launch with the
+    // cartridge in an unscanned folder (a phone, a second drive) permanent.
+    //
+    // Everything that decides *what to draw* goes through gCnTextPackActive or
+    // through cn_text_pack_target() again (rom_assets.c does the latter), so the
+    // config value is never mistaken for the live one.
+    gCnTextPackActive = target ? 1 : 0;
+
+    // The tables are NOT swapped here on purpose. The pack overwrites the
+    // vanilla dialog / course / act tables when a level is loaded
+    // (chinese_text_pack_on_level_load), so the title screen and the file
+    // select keep the game's own text and the swap happens where the player
+    // can see it take effect. See that function for the full rationale.
+
+    LOG_INFO("chinese text pack: iQue rom %s (%s), pack %s",
+             detected ? "found" : "not found",
+             loaded ? "assets loaded" : "assets unavailable",
+             target ? "enabled" : "disabled");
+}
+
+// Runtime toggle used by the MISC settings checkbox.
+//
+// It stores the choice and swaps the textures, but deliberately does NOT touch
+// the text tables: the dialog / course / act tables are swapped when a level is
+// loaded (chinese_text_pack_on_level_load below). That is what keeps a dialog
+// that is already on screen from changing language mid-sentence, and it makes
+// "flip the switch, then enter the level you want to read" the mental model.
+void chinese_text_pack_set_active(bool active) {
+    // The checkbox is greyed out without the dump, so this is defence in depth
+    // for the paths that do not go through the UI (a config reload, a future
+    // caller): switching the pack on without the dump would draw nothing.
+    // Refuse without touching the stored choice -- a click that cannot take
+    // effect must not rewrite what the player asked for.
+    if (active && !cn_rom_assets_ready()) {
+        return;
+    }
+
+    configChineseText = active;
+    // The pack also swaps a handful of textures (the power meter's 「力量」 and
+    // the title wordmark). Those are art, not text, so they follow the switch
+    // immediately -- there is no dialog to cut in half.
+    cn_tex_apply(active);
+    configfile_save(configfile_name());
+}
+
+// Called from level_init(): this is the only place the text tables change.
+//
+// The gate is re-evaluated here rather than at the moment the checkbox flips,
+// so the state a player sees is always "the choice as of the last level load".
+void chinese_text_pack_on_level_load(void) {
+    bool const target = cn_text_pack_target(cn_rom_assets_ready(), configChineseText);
+
+    gCnTextPackActive = target ? 1 : 0;
+    apply_cn_text_pack();
+}
+
+#endif
