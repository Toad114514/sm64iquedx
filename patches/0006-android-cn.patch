+# CN_TEXT_PACK - embeds the Simplified-Chinese (iQue) in-game text pack.
+# This swaps the vanilla dialog / course / act strings for their two-byte CN
+# equivalents so the in-game dialog boxes and star-select screens render in
+# Chinese. Rendering support lives in src/game/cn_font.c.
+#   true  - Chinese text pack enabled (default)
+#   false - original English strings
+CN_TEXT_PACK ?= true
+
+ifeq ($(CN_TEXT_PACK),true)
+  DEFINES += SM64COOPDX_CN_TEXT=1
+endif
