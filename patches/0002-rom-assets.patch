+// Is a romhack among the enabled mods? Storage for cn_text_gate.h's extern.
+//
+// Defined *outside* SM64COOPDX_CN_TEXT on purpose: rom_assets.c runs the same
+// gate on the loading thread and is compiled in both states (the pack itself is
+// stubbed out by cn_tex.c when the flag is off), so the symbol has to exist
+// there too. It stays false whenever the pack is compiled out.
+bool gCnTextPackRomhack = false;
+
+#if defined(SM64COOPDX_CN_TEXT)
+// Called once the vanilla rom has been imported and DJUI is up.
+//
+// Nothing about the pack is compiled in: the glyphs, the dialog text, the
+// course/act names and the localised textures are all read out of the player's
+// own 神游 dump at startup (cn_rom_assets.c). Owning the cartridge is therefore
+// no longer a condition we merely *check* -- without it there are no pixels and
+// no strings, so the pack cannot be shown at all.
+//
+//   * the exact 神游 (iQue) rom dump is present -> on, unless the player
+//     unchecked the box (the checkbox is the only thing that ever changes it)
+//   * it is not present, or an enabled mod is a romhack -> off for this
+//     session and the settings checkbox is greyed out (djui_panel_misc.c)
+//
+// configChineseText is the checkbox position, not the live state -- a config
+// written by an older build can carry "true" on a machine that never supplied
+// the rom, and the pack must not light up because of it. Only the live state
+// changes here; the stored value is left alone (see below).
+
+// Is one of the enabled mods a romhack?
+//
+// The two questions that can be asked about one mod live in cn_romhack.h (a
+// header, so .workbuddy/test_cn_romhack.sh can compile the real rule against a
+// table instead of trusting a regex on this file):
+//
+//   * does its metadata say `-- incompatible: romhack`?
+//   * does it ship a levels/ directory?
+//
+// Either one makes the iQue data meaningless. An actor model (Character
+// Select's skins, usm's three decorative actors) or a behavior script does not:
+// neither touches the level list, the course/act tables or the text id space.
+// Counting actors/ used to grey the pack out for a player whose only "romhack"
+// was a skin -- the comment in cn_romhack.h spells out the rule.
+static bool mod_is_romhack(const struct Mod *mod) {
+    u16 f;
+
+    if (cn_incompatible_is_romhack(mod->incompatible)) { return true; }
+
+    for (f = 0; f < mod->fileCount; f++) {
+        if (cn_path_ships_levels(mod->files[f].relativePath)) { return true; }
+    }
+
+    return false;
+}
+
+// gLocalMods (not gActiveMods) is the right list to read at startup: mods_activate()
+// runs late (it is called from network_init(), i.e. *after* chinese_text_pack_init()),
+// while gLocalMods is already populated and carries the enabled flags by the time
+// mods_init()/enable_queued_mods() have run. Once a session is being started the
+// active set is authoritative instead -- it also covers mods streamed in from a
+// server, which never appear in gLocalMods.
+static bool cn_romhack_mods_present(void) {
+    struct Mods *list = (gActiveMods.entryCount > 0) ? &gActiveMods : &gLocalMods;
+    u16 i;
+
+    for (i = 0; i < list->entryCount; i++) {
+        struct Mod *mod = list->entries[i];
+
+        if (mod == NULL || !mod->enabled) { continue; }
+        if (mod_is_romhack(mod)) { return true; }
+    }
+
+    return false;
+}
+
+// Keep the live pack state consistent with the mod set.
+//
+// Called from chinese_text_pack_init() (startup / config reload) and from
+// mods_activate() (the player ticked a mod in the menu and pressed 创建). The
+// second call is what makes "enable a romhack, start a game" turn the pack off
+// without a restart, instead of keeping iQue's tables over hacked data.
+void cn_text_pack_romhack_refresh(void) {
+    bool const romhack = cn_romhack_mods_present();
+
+    gCnTextPackRomhack = romhack;
+
+    if (!romhack || !gCnTextPackActive) { return; }
+
+    // A romhack arrived while the pack was live. Everything that decides *what
+    // to draw* reads gCnTextPackActive, so dropping it is enough for the glyphs,
+    // the dialog tables and the course/act names; the texture overlay keeps its
+    // own copy of the US pixels and has to be told explicitly.
+    gCnTextPackActive = 0;
+    apply_cn_text_pack();
+    cn_tex_apply(false);
+    LOG_INFO("chinese text pack: disabled, a loaded mod replaces the game's own data");
+}
+
+static void chinese_text_pack_init(void) {
+    bool const detected = rom_checker_ique_rom_present();
+
+    // The pack is no longer compiled into the binary: every glyph, dialog
+    // string and localised texture is read out of the player's own 神游 dump at
+    // startup (cn_rom_assets.c). Owning the cartridge is therefore no longer a
+    // precondition we merely *check* -- without it there is no data to show.
+    bool const loaded = detected && cn_rom_assets_load(rom_checker_ique_rom_path());
+
+    // A romhack re-authors the US data the pack would sit on top of, so it wins
+    // over both detection and the stored choice (rule 2 in cn_text_gate.h).
+    // Read here -- after mods_init()/enable_queued_mods() have run, before
+    // anything is drawn.
+    bool const romhack = cn_romhack_mods_present();
+
+    gCnTextPackRomhack = romhack;
+
+    // No rom / unreadable rom / romhack -> off. Otherwise the checkbox decides,
+    // and its default is on. The rule itself lives in cn_text_gate.h so it can
+    // be tested on its own.
+    bool const target = cn_text_pack_target(loaded, configChineseText, romhack);
+
+    // configChineseText is deliberately left as the player wrote it: it is the
+    // checkbox position, not the live state. A missing dump only means "not
+    // this session", and storing false here would make one launch with the
+    // cartridge in an unscanned folder (a phone, a second drive) permanent.
+    //
+    // Everything that decides *what to draw* goes through gCnTextPackActive or
+    // through cn_text_pack_target() again (rom_assets.c does the latter), so the
+    // config value is never mistaken for the live one.
+    gCnTextPackActive = target ? 1 : 0;
+
+    // The tables are NOT swapped here on purpose. The pack overwrites the
+    // vanilla dialog / course / act tables when a level is loaded
+    // (chinese_text_pack_on_level_load), so the title screen and the file
+    // select keep the game's own text and the swap happens where the player
+    // can see it take effect. See that function for the full rationale.
+
+    // rom_assets.c already made the same decision for the textures, but it runs
+    // on the loading thread *before* the mods are known, so with the rom present
+    // it overlaid the iQue pixels and only later do we find out that a romhack
+    // replaced the data underneath. Restore the US pixels in that case; with no
+    // rom it is a no-op because cn_tex only applies what it has.
+    if (!target) {
+        cn_tex_apply(false);
+    }
+
+    LOG_INFO("chinese text pack: iQue rom %s (%s), pack %s%s",
+             detected ? "found" : "not found",
+             loaded ? "assets loaded" : "assets unavailable",
+             target ? "enabled" : "disabled",
+             romhack ? " (romhack mod loaded: US data, no translation)" : "");
+}
+
+// Runtime toggle used by the MISC settings checkbox.
+//
+// It stores the choice and swaps the textures, but deliberately does NOT touch
+// the text tables: the dialog / course / act tables are swapped when a level is
+// loaded (chinese_text_pack_on_level_load below). That is what keeps a dialog
+// that is already on screen from changing language mid-sentence, and it makes
+// "flip the switch, then enter the level you want to read" the mental model.
+void chinese_text_pack_set_active(bool active) {
+    // The checkbox is greyed out in both cases, so this is defence in depth for
+    // the paths that do not go through the UI (a config reload, a future
+    // caller): switching the pack on without the dump would draw nothing, and
+    // switching it on over a romhack produces the mixed state (iQue tables over
+    // hacked ids) that cn_text_gate.h exists to prevent. Refuse without
+    // touching the stored choice -- a click that cannot take effect must not
+    // rewrite what the player asked for.
+    if (active && (!cn_rom_assets_ready() || gCnTextPackRomhack)) {
+        return;
+    }
+
+    configChineseText = active;
+    // The pack also swaps a handful of textures (the power meter's 「力量」 and
+    // the title wordmark). Those are art, not text, so they follow the switch
+    // immediately -- there is no dialog to cut in half.
+    cn_tex_apply(active);
+    configfile_save(configfile_name());
+}
+
+// Called from level_init(): this is the only place the text tables change.
+//
+// The gate is re-evaluated here rather than at the moment the checkbox flips,
+// so the state a player sees is always "the choice as of the last level load".
+// A romhack can also appear between two levels (a mod got enabled), which is
+// the other reason to re-derive instead of remembering a boolean.
+void chinese_text_pack_on_level_load(void) {
+    bool const target = cn_text_pack_target(cn_rom_assets_ready(), configChineseText, gCnTextPackRomhack);
+
+    gCnTextPackActive = target ? 1 : 0;
+    apply_cn_text_pack();
+}
+
+#endif
+
