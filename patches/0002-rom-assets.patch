+#if defined(SM64COOPDX_CN_TEXT)
+// Called once the vanilla rom has been imported and DJUI is up.
+//
+// Nothing about the pack is compiled in: the glyphs, the dialog text, the
+// course/act names and the localised textures are all read out of the player's
+// own 神游 dump at startup (cn_rom_assets.c). Owning the cartridge is therefore
+// no longer a condition we merely *check* -- without it there are no pixels and
+// no strings, so the pack cannot be shown at all.
+//
+//   * the exact 神游 (iQue) rom dump is present -> default on, and the player
+//     may switch it off by hand (that choice then wins over detection in both
+//     directions, otherwise unchecking the box would silently undo itself on
+//     the next start)
+//   * it is not present -> off for this session, the settings checkbox is
+//     greyed out, and a hint explains why (djui_panel_misc.c)
+//
+// The gate is deliberately unconditional: a config written by an older build
+// can carry configChineseText = true on a machine that never supplied the rom,
+// and the pack must not light up just because configChineseTextUserSet was set
+// once. The stored value is not rewritten (see below) -- only the live state is.
+//
+// Note for configs written by an older build: configChineseTextPrompted could
+// only become true by answering the old first-run box; that answer is now
+// re-derived from detection (owning the rom means "on").
+static void chinese_text_pack_init(void) {
+    bool const detected = rom_checker_ique_rom_present();
+
+    // The pack is no longer compiled into the binary: every glyph, dialog
+    // string and localised texture is read out of the player's own 神游 dump at
+    // startup (cn_rom_assets.c). Owning the cartridge is therefore no longer a
+    // precondition we merely *check* -- without it there is no data to show.
+    bool const loaded = detected && cn_rom_assets_load(rom_checker_ique_rom_path());
+
+    // No rom / unreadable rom -> off, no matter what the config says. With the
+    // rom -> the player's manual choice if there is one, otherwise on. The rule
+    // itself lives in cn_text_gate.h so it can be tested on its own.
+    bool const target = cn_text_pack_target(loaded, configChineseTextUserSet, configChineseText);
+
+    // configChineseText is deliberately left as the player wrote it. A missing
+    // dump only means "not this session": storing false here would make one
+    // launch with the cartridge in an unscanned folder (a phone, a second
+    // drive) silently permanent, and the player would have no way back short of
+    // toggling the box while the dump is nowhere to be found.
+    //
+    // Everything that decides *what to draw* goes through gCnTextPackActive or
+    // through cn_text_pack_target() again (rom_assets.c does the latter), so the
+    // config value is never mistaken for the live one.
+    bool const needSave = !configChineseTextPrompted;
+    configChineseTextPrompted = true;
+
+    gCnTextPackActive = target ? 1 : 0;
+    apply_cn_text_pack();
+
+    if (needSave) {
+        configfile_save(configfile_name());
+    }
+
+    LOG_INFO("chinese text pack: iQue rom %s (%s), pack %s%s",
+             detected ? "found" : "not found",
+             loaded ? "assets loaded" : "assets unavailable",
+             target ? "enabled" : "disabled",
+             (loaded && configChineseTextUserSet) ? " (kept: set by the player)" : "");
+}
+
+// Runtime toggle used by the MISC settings checkbox. Swaps the live dialog /
+// course / act tables and makes the choice persistent.
+void chinese_text_pack_set_active(bool active) {
+    // The settings checkbox is already greyed out without the rom; this second
+    // gate covers the paths that do not go through the UI (a config reload, a
+    // future caller), so "no cart, no text" cannot be bypassed by accident.
+    if (active && !cn_rom_assets_ready()) {
+        active = false;
+    }
+    configChineseText = active;
+    // Once the player flips this switch by hand, rom detection stops being the
+    // authority on it.
+    configChineseTextUserSet = true;
+    configChineseTextPrompted = true;
+    gCnTextPackActive = active ? 1 : 0;
+    apply_cn_text_pack();
+    // The pack also swaps a handful of textures (the power meter's 「力量」 and
+    // the title wordmark). Re-apply them so the change is visible without a
+    // restart -- cn_tex restores the saved US pixels when `active` is false.
+    cn_tex_apply(active);
+    configfile_save(configfile_name());
+}
+#endif
